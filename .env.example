# Copie para .env.production (ou defina nas variáveis do projeto na Vercel).

# URL publicada desta landing (canonical e og:url). Sem ela, a página sai sem
# canonical e com noindex, para não concorrer com outras páginas da MSSERVER.
# Ex.: PUBLIC_CANONICAL_URL=https://msserver.com.br/cloud-para-empresas/
PUBLIC_CANONICAL_URL=

# Container do Google Tag Manager usado em msserver.com.br. Sem esta variável, a
# página não carrega o GTM (os eventos ficam só no dataLayer local).
# Deixe vazio se a página for servida dentro do WordPress (o site já carrega o GTM).
PUBLIC_GTM_ID=

# "true" força noindex mesmo com PUBLIC_CANONICAL_URL definida (homologação).
PUBLIC_NOINDEX=false

# Caminho de publicação (base dos assets). Ex.: /cloud-para-empresas
BASE_PATH=/
