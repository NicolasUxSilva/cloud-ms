---
import Icon from './Icon.astro';
import { BENEFITS } from '../data/content';
---

<section class="section" id="beneficios" aria-labelledby="ben-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow"><b>01</b> Benefícios</p>
        <h2 id="ben-title">A infraestrutura da empresa, sem o peso do equipamento</h2>
      </div>
      <p>
        A Cloud da MSSERVER é fornecida sob demanda: a empresa dimensiona os recursos de que precisa e cresce no mesmo ambiente, com a segurança e o controle de uma nuvem exclusiva.
      </p>
    </div>

    <ul class="ben-grid">
      {
        BENEFITS.map((b, i) => (
          <li class="ben-card" data-reveal style={`--reveal-i:${i % 3}`}>
            <span class="icon-tile">
              <Icon name={b.icon} />
            </span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ben-grid {
    list-style: none;
    display: grid;
    gap: 1px;
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-line);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .ben-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ben-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ben-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1.2rem + 0.8vw, 2rem);
    background: var(--c-surface);
    transition: background-color 0.2s var(--ease-out);
  }

  .ben-card:hover {
    background: #fffdf9;
  }

  .ben-card h3 {
    margin-top: 0.5rem;
    font-size: 1.15rem;
  }

  .ben-card p {
    color: var(--c-ink-2);
    font-size: 0.975rem;
  }

  @media (max-width: 639px) {
    .ben-card {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.9rem;
      padding: 1.25rem;
    }

    .ben-card .icon-tile {
      grid-row: span 2;
    }

    .ben-card h3 {
      margin-top: 0;
      align-self: center;
    }
  }
</style>
