---
import { Image } from 'astro:assets';
import team from '../assets/photos/equipe-msserver.jpg';
import { STATS } from '../data/content';
---

<section class="section section--dark on-dark" id="equipe" aria-labelledby="proof-title">
  <div class="container">
    <div class="proof-top">
      <div class="proof-copy">
        <p class="eyebrow"><b>07</b> Do outro lado</p>
        <h2 id="proof-title">Uma equipe técnica para dividir o projeto</h2>
        <p class="proof-lead">Quando você leva uma demanda, conversa com especialistas de uma empresa nacional, da análise à migração. O atendimento técnico funciona 24/7 por telefone e portal, e o comercial das 8h às 18h.</p>
        <dl class="proof-stats">
          {
            STATS.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <figure class="proof-photo" data-reveal>
        <Image src={team} alt="Equipe da MSSERVER reunida no escritório, com camisetas da empresa" widths={[640, 960, 1400, 1800]} sizes="(min-width: 1024px) 680px, 100vw" loading="lazy" />
        <figcaption>Equipe MSSERVER</figcaption>
      </figure>
    </div>

  </div>
</section>

<style>
  .proof-top {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .proof-top {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 4rem;
    }
  }

  .proof-copy h2 {
    margin-top: 1.25rem;
    font-size: var(--t-h2);
    max-width: 14ch;
  }

  .proof-lead {
    margin-top: 1.25rem;
    color: var(--c-on-dark-2);
    font-size: var(--t-lead);
    max-width: 46ch;
  }

  .proof-stats {
    display: flex;
    gap: 2.5rem;
    margin: 2.25rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line-dark);
  }

  .proof-stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .proof-stats dd {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--c-on-dark);
  }

  .proof-stats dt {
    margin-top: 0.4rem;
    color: var(--c-on-dark-2);
    font-size: 0.9rem;
  }

  .proof-photo {
    position: relative;
    margin: 0;
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--c-indigo-900);
  }

  .proof-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proof-photo figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.35rem 0.65rem;
    border-radius: 8px;
    background: rgb(14 13 34 / 0.72);
    backdrop-filter: blur(6px);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

</style>
